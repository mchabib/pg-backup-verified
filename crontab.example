# m  h  dom mon dow  command
# Daily logical backup at 01:30
30 1 * * *   /opt/pg-backup-verified/backup_dumpall.sh    >/dev/null 2>&1
# Weekly physical backup, Sunday 02:30
30 2 * * 0   /opt/pg-backup-verified/backup_basebackup.sh >/dev/null 2>&1
# Weekly restore drill, Sunday 05:00 (after the backups)
0  5 * * 0   /opt/pg-backup-verified/restore_drill.sh     >/dev/null 2>&1
# Staleness check every 6 hours, independent of the backup jobs
0 */6 * * *  /opt/pg-backup-verified/check_staleness.sh   >/dev/null 2>&1
