# cp .env.example .env && chmod 600 .env

# --- PostgreSQL connection ---
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=

# --- Storage ---
BACKUP_ROOT_DIR=/var/backups/postgresql
RETENTION_DAYS=7

# --- Which methods run on this server ---
ENABLE_DUMPALL=true
ENABLE_BASEBACKUP=false

# --- Staleness limits (hours) for check_staleness.sh ---
# Rule of thumb: 2x the cron interval.
DUMPALL_STALE_HOURS=48
BASEBACKUP_STALE_HOURS=336

# --- Manifest / restore drill ---
VERIFY_TABLE_LIMIT=20        # exact row counts for the N largest tables per database
DRILL_IMAGE=postgres:16      # must match the source major version
DRILL_TOLERANCE_PCT=5        # allowed row-count drift (dump is taken on a live server)

# --- Labels & logs ---
SERVER_LABEL=db-primary
LOG_DIR=./logs

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
